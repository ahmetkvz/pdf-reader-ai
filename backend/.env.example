# Bu dosyayi backend/.env olarak kopyalayip degerleri doldurun.

# --- Veritabani ---
# Zorunlu; yoksa uygulama acilmaz.
MONGO_URI=mongodb+srv://kullanici:sifre@cluster.mongodb.net/veritabani
# Istege bagli; varsayilan: pdf_reader_ai
DB_NAME=pdf_reader_ai

# --- Kimlik dogrulama ---
# Zorunlu; yoksa uygulama acilmaz. Uzun ve rastgele olmali.
JWT_SECRET=uzun-rastgele-bir-metin
# Istege bagli; varsayilan: HS256
JWT_ALGORITHM=HS256
# Istege bagli; varsayilan: 60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Yapay zeka (Groq) ---
# Analiz ve sohbet icin gerekli; varsayilan yok.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Istege bagli; varsayilan: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# Istege bagli; varsayilan: 1000
CHAT_MAX_TOKENS=1000
# Istege bagli; varsayilan: 0.2
AI_TEMPERATURE=0.2

# --- Belge isleme ---
# Istege bagli; varsayilan: 500
MAX_PDF_PAGES=500

# --- E-posta (Resend) ---
# Sifre sifirlama maili icin gerekli; varsayilan yok.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
